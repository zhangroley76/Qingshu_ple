@@ -244,6 +244,38 @@ impl BigramModel {
         self.metadata.as_ref()
     }
 
+    /// 词表里有没有这个词。
+    pub fn contains(&self, word: &str) -> bool {
+        self.word_id(word).is_some()
+    }
+
+    /// 联想（Qingshu）：`previous` 之后最常接的词，按二元计数降序，最多 `limit` 个；不含句首标记。
+    pub fn top_successors(&self, previous: &str, limit: usize) -> Vec<(&str, u32)> {
+        let Some(id) = self.word_id(previous) else {
+            return Vec::new();
+        };
+        let (Some(&start), Some(&end)) = (
+            self.offsets.get(id as usize),
+            self.offsets.get(id as usize + 1),
+        ) else {
+            return Vec::new();
+        };
+        let mut successors: Vec<Successor> = self.successors[start as usize..end as usize].to_vec();
+        successors.sort_unstable_by(|a, b| b.count.cmp(&a.count).then(a.word.cmp(&b.word)));
+        successors
+            .into_iter()
+            .filter(|s| Some(s.word) != self.start)
+            .map(|s| {
+                (
+                    word_text(&self.words, &self.entries[s.word as usize]),
+                    s.count,
+                )
+            })
+            .filter(|(word, _)| !word.is_empty())
+            .take(limit)
+            .collect()
+    }
+
     fn word_id(&self, word: &str) -> Option<u32> {
         hash::find(&self.index, word, |id| {
             word_text(&self.words, &self.entries[id as usize])
@@ -313,6 +345,15 @@ mod tests {
     const UNIGRAM: &str = "<s>\t100\n我\t50\n想\t30\n去\t20\n翔\t1\n";
     const BIGRAM: &str = "<s>\t我\t40\n我\t想\t25\n想\t去\t15\n我\t翔\t1\n";
 
+    #[test]
+    fn top_successors_are_sorted_by_count_and_skip_unknown_words() {
+        let model = BigramModel::parse(UNIGRAM, BIGRAM).unwrap();
+        assert_eq!(model.top_successors("我", 5), vec![("想", 25), ("翔", 1)]);
+        assert_eq!(model.top_successors("我", 1), vec![("想", 25)]);
+        assert!(model.top_successors("你", 5).is_empty());
+        assert!(model.contains("去") && !model.contains("你"));
+    }
+
     #[test]
     fn bigram_beats_unigram_and_unknown_words_are_none() {
         let model = BigramModel::parse(UNIGRAM, BIGRAM).unwrap();
